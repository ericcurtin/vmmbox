# The QEMU that vmmbox ships. Sourced by build.sh and read by CI.
#
# vmmbox builds UNMODIFIED upstream QEMU: no patches, no fork. The only inputs
# are this release tarball and the configure flags in build.sh. Bump
# BUNDLE_REV when only the build recipe changes.
#
# This is 11.0.x, not 11.1.x, on purpose. virtio-fs on macOS needs vhost-user,
# and QEMU 11.1.0 through 11.1.2 (and master, as of September 2026) have a bug
# there: after SET_VRING_KICK, vhost_user_set_vring_kick() "injects a kick" by
# writing to the descriptor it just sent, which is the read end of a pipe on
# hosts without eventfd, so the write fails with EBADF and the device never
# starts. It was added by commit ef02c6be ("vhost-user: inject kick after
# SET_VRING_KICK"). 11.0.5 predates it. Move to a newer release once that is
# fixed upstream, and test it with a real guest first: the failure only shows
# when a guest driver starts the device, so smoke-test.sh cannot catch it.
QEMU_VERSION=11.0.5
QEMU_URL=https://download.qemu.org/qemu-11.0.5.tar.xz
# Checked against the release's GPG signature (qemu-11.0.5.tar.xz.sig, made by
# key CEACC9E15534EBABB82D3FA03353C9CEF108B584, Michael Roth, the stable
# maintainer): "Good signature".
QEMU_SHA256=38a1a09f349660cb0e20b8fe5f224d6a53ec4235eb36f2e33a31e21bb6138147
BUNDLE_REV=2
# The oldest macOS major version the bundle runs on: what the CI runner has.
# Its binaries and the Homebrew libraries bundled into it are built for that
# release, and smoke-test.sh checks that none needs anything newer. vmmbox
# will not install the bundle on an older macOS.
MIN_MACOS=15
